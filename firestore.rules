rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /tips/{id} {
      // Anyone may read approved, sample or community (unreviewed) tips.
      allow read: if resource.data.status in ['approved', 'sample', 'community'];
      // Signed-in (anonymous) users may submit a community tip. No uid is stored on the tip.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['topic','kind','claim','detail','when','status','createdAt'])
        && request.resource.data.status == 'community'
        && request.resource.data.claim is string && request.resource.data.claim.size() <= 220
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 700
        && request.resource.data.topic in ['hostel','academics','professors','paperwork','placements','campus']
        && request.resource.data.kind in ['process','pattern','warning','opinion']
        && request.resource.data.when in ['recent','last_year','older']
        && request.resource.data.createdAt == request.time
        // the owner record must be written in the same batch, by the same account
        && existsAfter(/databases/$(db)/documents/tipOwners/$(id))
        && getAfter(/databases/$(db)/documents/tipOwners/$(id)).data.uid == request.auth.uid;
      allow update: if false;
      // Only the anonymous account that created a tip can delete it (link kept in /tipOwners, not on the tip).
      allow delete: if request.auth != null
        && get(/databases/$(db)/documents/tipOwners/$(id)).data.uid == request.auth.uid;
    }
    match /tipOwners/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(db)/documents/tips/$(id))
        && existsAfter(/databases/$(db)/documents/tips/$(id));
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    match /official/{id} { allow read: if true; allow write: if false; }
  }
}
